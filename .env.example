# Local mode works without this file; export variables before starting services.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/agentscope
# DASHBOARD_PASSWORD=                 # Secure dashboard access beyond local development
# AGENTSCOPE_ADMIN_TOKEN=             # Optional shared backend/server-only proxy credential
# AGENTSCOPE_LLM_API_KEY=             # Optional, never exposed to the browser
# AGENTSCOPE_LLM_ALLOWED_HOSTS=api.openai.com
# API_PORT=8000
# PORT=3000
