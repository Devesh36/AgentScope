{
  "name": "agentscope",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "setup": "bash scripts/setup.sh",
    "build": "npm --prefix apps/web run build",
    "test:web": "npm --prefix apps/web test",
    "test:api": "cd apps/api && ../../.venv/bin/pytest -q",
    "accept:containers": ".venv/bin/python scripts/container_acceptance.py run",
    "test:cli": ".venv/bin/pytest packages/cli/tests -q",
    "accept:cli": ".venv/bin/python scripts/cli_acceptance.py",
    "accept:watch": ".venv/bin/python scripts/watch_acceptance.py",
    "accept:performance": ".venv/bin/python scripts/performance_acceptance.py"
  }
}
